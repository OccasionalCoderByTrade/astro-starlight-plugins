{
  "name": "starlight-cannoli-plugins",
  "type": "module",
  "version": "4.1.1",
  "description": "Starlight plugins for automatic sidebar generation and link validation",
  "license": "ISC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./starlight-index-only-sidebar": {
      "import": "./dist/plugins/starlight-index-only-sidebar.js",
      "types": "./dist/plugins/starlight-index-only-sidebar.d.ts"
    },
    "./starlight-index-sourced-sidebar": {
      "import": "./dist/plugins/starlight-index-sourced-sidebar.js",
      "types": "./dist/plugins/starlight-index-sourced-sidebar.d.ts"
    },
    "./rehype-validate-links": {
      "import": "./dist/plugins/rehype-validate-links.js",
      "types": "./dist/plugins/rehype-validate-links.d.ts"
    },
    "./astro-vscode-heading-ids": {
      "import": "./dist/plugins/astro-vscode-heading-ids.js",
      "types": "./dist/plugins/astro-vscode-heading-ids.d.ts"
    },
    "./astro-normalize-paths": {
      "import": "./dist/plugins/astro-normalize-paths.js",
      "types": "./dist/plugins/astro-normalize-paths.d.ts"
    },
    "./astro-local-links": {
      "import": "./dist/plugins/astro-local-links.js",
      "types": "./dist/plugins/astro-local-links.d.ts"
    },
    "./astro-latex-compile": {
      "import": "./dist/plugins/astro-latex-compile.js",
      "types": "./dist/plugins/astro-latex-compile.d.ts"
    },
    "./astro-serve-docs-files": {
      "import": "./dist/plugins/astro-serve-docs-files.js",
      "types": "./dist/plugins/astro-serve-docs-files.d.ts"
    },
    "./starlight-dom-patches": {
      "import": "./dist/plugins/starlight-dom-patches.js",
      "types": "./dist/plugins/starlight-dom-patches.d.ts"
    },
    "./expressive-code-emphasis": {
      "import": "./dist/plugins/expressive-code-emphasis.js",
      "types": "./dist/plugins/expressive-code-emphasis.d.ts"
    },
    "./styles/utilities.css": "./dist/styles/utilities.css",
    "./styles/starlight-theme.css": "./dist/styles/starlight-theme.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "astro",
    "starlight",
    "plugin",
    "sidebar",
    "rehype",
    "link-validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OccasionalCoderByTrade/astro-starlight-plugins"
  },
  "scripts": {
    "app:dev": "npm run app:preprocess && rm -rf .astro/ && astro dev --host --port 5600",
    "app:build": "npm run app:preprocess && rm -rf .astro/ && astro build",
    "app:preview": "npm run app:build && astro preview --port 5600",
    "app:preprocess": "npx sass --quiet --no-source-map src/styles/_bootstrap-utilities-builder.scss src/styles/_bootstrap-utilities.scss",
    "app:help": "astro --help",
    "app:check": "astro check",
    "lib:build": "npm run app:preprocess && tsup && tsx scripts/build-styles.ts",
    "prepublishOnly": "npm run lib:build",
    "tree:index": "tree -P index.md src/content/docs",
    "tree:depth": "bash scripts/tree-depth.sh",
    "vendor:fonts": "node scripts/vendor-source-code-pro.mjs",
    "clean:empty-dirs": "find src/content/docs -type d -empty -delete",
    "test": "vitest run"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "eslint-cannoli-plugins": "^1.0.13",
    "github-slugger": "^2.0.0",
    "minimatch": "^9.0.0",
    "parse5": "^8.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@astrojs/markdown-remark": "^6.0.0 || ^7.0.0",
    "@astrojs/starlight": ">=0.32.0",
    "@expressive-code/core": ">=0.41.7",
    "astro": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": false
    },
    "@astrojs/starlight": {
      "optional": true
    },
    "@expressive-code/core": {
      "optional": true
    },
    "@astrojs/markdown-remark": {
      "optional": false
    }
  },
  "overrides": {
    "@types/hast": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/starlight": "^0.42.6",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^7.5.1",
    "@expressive-code/core": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@hpcc-js/wasm": "^2.33.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/hast": "^3.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/mdast": "^4.0.4",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "astro": "^7.4.1",
    "bootstrap": "^5.3.8",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "hast": "^1.0.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "lodash": "^4.17.23",
    "mdast-util-to-hast": "^13.2.1",
    "pino": "^10.3.1",
    "rehype-class-names": "^2.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0",
    "sass-embedded": "^1.97.3",
    "starlight-image-zoom": "^0.16.2",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vfile": "^6.0.0",
    "vitest": "^5.0.2"
  }
}
